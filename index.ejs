<!DOCTYPE html>
<html>

<head>
    <title>Money Tracker</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">

        <h1>Money Tracker</h1>

        <!-- ADD TRANSACTION -->
        <div class="card form-card">
            <h2>Add Transaction</h2>
            <form action="/add" method="POST">
                <input type="number" name="amount" placeholder="Amount" required>

                <select name="type">
                    <option value="income">Income</option>
                    <option value="expense">Expense</option>
                </select>

                <select name="category">
                    <option disabled selected>Select Category</option>
                    <option value="food">Food</option>
                    <option value="travel">Travel</option>
                    <option value="shopping">Shopping</option>
                    <option value="salary">Salary</option>
                </select>

                <button type="submit">Add</button>
            </form>
        </div>

        <!-- FILTER -->
        <div class="card form-card">
            <h2>Filter</h2>
            <form action="/" method="GET">
                <select name="type">
                    <option value="">All Types</option>
                    <option value="income">Income</option>
                    <option value="expense">Expense</option>
                </select>

                <select name="category">
                    <option value="">All Categories</option>
                    <option value="food">Food</option>
                    <option value="travel">Travel</option>
                    <option value="shopping">Shopping</option>
                    <option value="salary">Salary</option>
                </select>

                <input type="month" name="month">
                <input type="number" name="year" placeholder="Year">

                <button type="submit">Filter</button>
            </form>
        </div>

        <!-- SUMMARY -->
        <div class="card summary-card">
            <h2>Summary</h2>
            <div class="summary-content">
                <p class="income-text">Income: ₹<%= income %>
                </p>
                <p class="expense-text">Expense: ₹<%= expense %>
                </p>
                <p class="balance-text"><strong>Balance: ₹<%= balance %></strong></p>
            </div>
        </div>

        <!-- ANALYTICS -->
        <div class="card analytics-card">
            <h2>Analytics</h2>
            <div class="chart-grid">
                <div class="chart-box">
                    <h3>Weekly Graph</h3>
                    <div class="chart-container">
                        <canvas id="myChartWeekly"></canvas>
                    </div>
                </div>

                <div class="chart-box">
                    <h3>Monthly Graph</h3>
                    <div class="chart-container">
                        <canvas id="myChart"></canvas>
                    </div>
                </div>

                <div class="chart-box">
                    <h3>Expenses Category Wise</h3>
                    <div class="chart-container">
                        <canvas id="pieChart"></canvas>
                    </div>
                </div>

                <div class="chart-box">
                    <h3>Income vs Expense</h3>
                    <div class="chart-container">
                        <canvas id="incomeExpenseChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- TRANSACTIONS -->
        <div class="card transactions-card">
            <h2>Transactions</h2>

            <ul class="transactions-list">
                <% transactions.forEach(t=> { %>
                    <li class="transaction-item">
                        <span class="transaction-amount <%= t.type === 'income' ? 'income-text' : 'expense-text' %>">
                            ₹<%= t.amount %> - <%= t.category %>
                        </span>

                        <span class="transaction-type">
                            <%= t.type %>
                        </span>

                        <form action="/delete/<%= t.id %>" method="POST" style="display:inline;">
                            <button class="delete-btn">Delete</button>
                        </form>
                    </li>
                    <% }) %>
            </ul>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- MONTHLY -->
    <script>
        fetch('/monthly-data')
            .then(res => res.json())
            .then(data => {

                const labels = data.map(item => item.month);
                const values = data.map(item => item.total);

                new Chart(document.getElementById('myChart'), {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Monthly Expenses',
                            data: values,
                            borderColor: '#4f46e5',
                            backgroundColor: 'rgba(79, 70, 229, 0.1)',
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            });
    </script>

    <!-- WEEKLY -->
    <script>
        fetch('/weekly-data')
            .then(res => res.json())
            .then(data => {

                const labels = data.map(item => `Week ${item.week} (${item.year})`);
                const values = data.map(item => item.expense);

                new Chart(document.getElementById('myChartWeekly'), {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Weekly Expenses',
                            data: values,
                            borderColor: '#0891b2',
                            backgroundColor: 'rgba(8, 145, 178, 0.1)',
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            });
    </script>

    <!-- CATEGORY PIE -->
    <script>
        fetch('/category-data')
            .then(res => res.json())
            .then(data => {

                const labels = data.map(item => item.category);
                const values = data.map(item => item.total);

                new Chart(document.getElementById('pieChart'), {
                    type: 'pie',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: [
                                '#ef4444',
                                '#f59e0b',
                                '#10b981',
                                '#3b82f6',
                                '#8b5cf6',
                                '#ec4899'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            });
    </script>

    <!-- INCOME VS EXPENSE -->
    <script>
        fetch('/income-expense-data')
            .then(res => res.json())
            .then(data => {

                const labels = data.map(item => item.month);
                const incomeData = data.map(item => item.income);
                const expenseData = data.map(item => item.expense);

                new Chart(document.getElementById('incomeExpenseChart'), {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Income',
                                data: incomeData,
                                borderColor: '#10b981',
                                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                                tension: 0.4
                            },
                            {
                                label: 'Expense',
                                data: expenseData,
                                borderColor: '#ef4444',
                                backgroundColor: 'rgba(239, 68, 68, 0.1)',
                                tension: 0.4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            });
    </script>
</body>

</html>